<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_board_line"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
    android:gravity="center_vertical" android:paddingVertical="1dp">
    <TextView android:id="@+id/widget_board_line_label" android:layout_width="46dp" android:layout_height="wrap_content"
        android:textSize="11sp" android:includeFontPadding="false" android:maxLines="1" />
    <ImageView android:id="@+id/widget_board_line_bar" android:layout_width="0dp" android:layout_height="5dp"
        android:layout_weight="1" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <TextView android:id="@+id/widget_board_line_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:minWidth="52dp" android:gravity="end" android:textSize="13sp" android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false" android:maxLines="1" />
</LinearLayout>
