<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_board_center"
    android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"
    android:gravity="center">
    <ImageView android:id="@+id/widget_board_center_badge" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:importantForAccessibility="no" />
    <TextView android:id="@+id/widget_board_center_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:gravity="center" android:textSize="18sp" android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false" android:maxLines="1" />
    <TextView android:id="@+id/widget_board_center_names" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:gravity="center" android:textSize="11sp" android:includeFontPadding="false" android:maxLines="2" />
</LinearLayout>
