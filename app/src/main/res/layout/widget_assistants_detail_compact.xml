<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/widget_surface" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:importantForAccessibility="no" android:src="@drawable/widget_assistants_surface" />
    <ImageView android:id="@+id/widget_outline" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:alpha="0.65" android:importantForAccessibility="no" android:src="@drawable/widget_assistants_outline" />
    <LinearLayout android:id="@+id/widget_contents" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="20dp" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_brand" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/app_name" android:textSize="9sp"
                android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" />
            <ImageView android:id="@+id/widget_refresh" android:layout_width="20dp" android:layout_height="20dp"
                android:padding="5dp" android:background="@drawable/widget_refresh_background" android:contentDescription="@string/widget_refresh_description" android:src="@drawable/widget_ic_refresh" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_usage_sections" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="2dp" android:orientation="vertical" android:gravity="center_vertical">
            <LinearLayout android:id="@+id/widget_cursor_section" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginEnd="4dp" android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <TextView android:id="@+id/widget_cursor_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Cursor" android:textSize="12sp" android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
                        <TextView android:id="@+id/widget_cursor_plan" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="6dp" android:maxWidth="92dp" android:background="@drawable/widget_plan_badge"
                            android:paddingHorizontal="5dp" android:paddingVertical="2dp" android:textSize="8sp"
                            android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
                    </LinearLayout>
                        <TextView android:id="@+id/widget_cursor_caption" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="2dp" android:text="@string/overview_cycle_used" android:textSize="9sp"
                            android:includeFontPadding="false" android:maxLines="1" />
                    </LinearLayout>
                    <TextView android:id="@+id/widget_cursor_value" android:layout_width="85dp" android:layout_height="26dp"
                        android:textSize="22sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false"
                        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="22sp"
                        android:autoSizeStepGranularity="1sp" android:gravity="end|center_vertical" android:maxLines="1" />
                </LinearLayout>
                <ProgressBar android:id="@+id/widget_cursor_progress" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp" android:max="100" android:progressDrawable="@drawable/widget_progress_primary" />
                <TextView android:id="@+id/widget_cursor_info" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="9sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
            <ImageView android:id="@+id/widget_usage_divider" android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginTop="3dp" android:layout_marginBottom="3dp"
                android:background="@color/widget_surface_variant" android:importantForAccessibility="no" />
            <LinearLayout android:id="@+id/widget_codex_section" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <TextView android:id="@+id/widget_codex_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Codex" android:textSize="12sp" android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
                        <TextView android:id="@+id/widget_codex_plan" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="6dp" android:maxWidth="92dp" android:background="@drawable/widget_plan_badge"
                            android:paddingHorizontal="5dp" android:paddingVertical="2dp" android:textSize="8sp"
                            android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
                    </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="18dp"
                    android:layout_marginTop="3dp" android:gravity="center_vertical">
                    <TextView android:id="@+id/widget_codex_primary_label" android:layout_width="44dp" android:layout_height="wrap_content"
                        android:text="@string/quota_five_hour_short" android:textSize="9sp" android:includeFontPadding="false" android:maxLines="1" />
                    <TextView android:id="@+id/widget_codex_primary_reset" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginHorizontal="4dp" android:textSize="9sp"
                        android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
                    <TextView android:id="@+id/widget_codex_primary_value" android:layout_width="46dp" android:layout_height="18dp"
                        android:textSize="14sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false"
                        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="14sp"
                        android:autoSizeStepGranularity="1sp" android:gravity="end|center_vertical" android:maxLines="1" />
                </LinearLayout>
                <ProgressBar android:id="@+id/widget_codex_primary_progress" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="1dp"
                    android:layout_marginBottom="2dp" android:max="100" android:progressDrawable="@drawable/widget_progress_secondary" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="18dp" android:gravity="center_vertical">
                    <TextView android:id="@+id/widget_codex_weekly_label" android:layout_width="44dp" android:layout_height="wrap_content"
                        android:text="@string/quota_weekly_short" android:textSize="9sp" android:includeFontPadding="false" android:maxLines="1" />
                    <TextView android:id="@+id/widget_codex_weekly_reset" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginHorizontal="4dp" android:textSize="9sp"
                        android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
                    <TextView android:id="@+id/widget_codex_week" android:layout_width="46dp" android:layout_height="18dp"
                        android:textSize="14sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false"
                        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="14sp"
                        android:autoSizeStepGranularity="1sp" android:gravity="end|center_vertical" android:maxLines="1" />
                </LinearLayout>
                <ProgressBar android:id="@+id/widget_codex_weekly_progress" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="1dp"
                    android:max="100" android:progressDrawable="@drawable/widget_progress_secondary" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textSize="9sp" android:includeFontPadding="false"
            android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
