<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent">
    <ImageView android:id="@+id/widget_surface" android:contentDescription="@null" android:importantForAccessibility="no" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_assistants_surface" />
    <ImageView android:id="@+id/widget_outline" android:contentDescription="@null" android:importantForAccessibility="no" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_assistants_outline" android:alpha="0.55" />
    <LinearLayout android:id="@+id/widget_contents" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="10dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_brand" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/app_name" android:textSize="14sp" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/widget_on_surface" android:layout_weight="1" android:fontFamily="sans-serif-medium" />
            <ImageView android:id="@+id/widget_refresh" android:layout_width="28dp" android:layout_height="28dp" android:padding="6dp" android:src="@drawable/widget_ic_refresh" android:background="@drawable/widget_refresh_background" android:contentDescription="@string/widget_refresh_description" android:clickable="true" android:focusable="true" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_usage_sections" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="3dp" android:orientation="vertical" android:gravity="center_vertical">
            <LinearLayout android:id="@+id/widget_cursor_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical" android:padding="8dp" android:background="@drawable/widget_panel_background">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                            <TextView android:id="@+id/widget_cursor_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cursor" android:textSize="18sp" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/widget_on_surface" android:fontFamily="sans-serif-medium" />
                            <TextView android:id="@+id/widget_cursor_plan" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/widget_on_surface" android:layout_marginStart="6dp" android:maxWidth="76dp" android:background="@drawable/widget_plan_badge" android:paddingHorizontal="5dp" android:paddingVertical="2dp" android:ellipsize="end" />
                        </LinearLayout>
                        <TextView android:id="@+id/widget_cursor_caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/overview_cycle_used" android:textSize="11sp" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/widget_on_surface" android:layout_marginTop="2dp" />
                    </LinearLayout>
                    <TextView android:id="@+id/widget_cursor_value" android:layout_width="114dp" android:layout_height="40dp" android:text="" android:textSize="34sp" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/widget_on_surface" android:gravity="end|center_vertical" android:fontFamily="sans-serif-medium" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="34sp" android:autoSizeStepGranularity="1sp" />
                </LinearLayout>
                <ProgressBar android:id="@+id/widget_cursor_progress" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="5dp" android:layout_marginBottom="5dp" android:max="100" android:progressDrawable="@drawable/widget_progress_primary" style="?android:attr/progressBarStyleHorizontal" />
                <TextView android:id="@+id/widget_cursor_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:includeFontPadding="false" android:maxLines="2" android:textColor="@color/widget_on_surface" android:ellipsize="end" />
            </LinearLayout>
            <ImageView android:id="@+id/widget_usage_divider" android:contentDescription="@null" android:importantForAccessibility="no" android:layout_width="match_parent" android:layout_height="8dp" android:alpha="0" />
            <LinearLayout android:id="@+id/widget_codex_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical" android:padding="8dp" android:background="@drawable/widget_panel_background">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <TextView android:id="@+id/widget_codex_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Codex" android:textSize="18sp" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/widget_on_surface" android:fontFamily="sans-serif-medium" />
                    <TextView android:id="@+id/widget_codex_plan" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/widget_on_surface" android:layout_marginStart="6dp" android:maxWidth="76dp" android:background="@drawable/widget_plan_badge" android:paddingHorizontal="5dp" android:paddingVertical="2dp" android:ellipsize="end" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="12dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                            <TextView android:id="@+id/widget_codex_primary_label" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/quota_five_hour_short" android:textSize="12sp" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/widget_on_surface" android:layout_weight="1" />
                            <TextView android:id="@+id/widget_codex_primary_value" android:layout_width="78dp" android:layout_height="34dp" android:text="" android:textSize="28sp" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/widget_on_surface" android:fontFamily="sans-serif-medium" android:gravity="end|center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="28sp" android:autoSizeStepGranularity="1sp" />
                        </LinearLayout>
                        <ProgressBar android:id="@+id/widget_codex_primary_progress" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="2dp" android:layout_marginBottom="3dp" android:max="100" android:progressDrawable="@drawable/widget_progress_secondary" style="?android:attr/progressBarStyleHorizontal" />
                        <TextView android:id="@+id/widget_codex_primary_reset" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:includeFontPadding="false" android:maxLines="2" android:textColor="@color/widget_on_surface" android:ellipsize="end" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                            <TextView android:id="@+id/widget_codex_weekly_label" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/quota_weekly_short" android:textSize="12sp" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/widget_on_surface" android:layout_weight="1" />
                            <TextView android:id="@+id/widget_codex_week" android:layout_width="78dp" android:layout_height="34dp" android:text="" android:textSize="28sp" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/widget_on_surface" android:fontFamily="sans-serif-medium" android:gravity="end|center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="28sp" android:autoSizeStepGranularity="1sp" />
                        </LinearLayout>
                        <ProgressBar android:id="@+id/widget_codex_weekly_progress" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="2dp" android:layout_marginBottom="3dp" android:max="100" android:progressDrawable="@drawable/widget_progress_secondary" style="?android:attr/progressBarStyleHorizontal" />
                        <TextView android:id="@+id/widget_codex_weekly_reset" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:includeFontPadding="false" android:maxLines="2" android:textColor="@color/widget_on_surface" android:ellipsize="end" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/widget_on_surface" android:layout_marginTop="4dp" android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>