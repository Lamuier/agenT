<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_board_hero"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="2dp">
    <TextView android:id="@+id/widget_board_hero_caption" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="11sp" android:includeFontPadding="false" android:maxLines="1" />
    <TextView android:id="@+id/widget_board_hero_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:textSize="18sp" android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false" android:maxLines="1" />
    <TextView android:id="@+id/widget_board_hero_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="3dp" android:textSize="11sp" android:includeFontPadding="false" android:maxLines="1" />
</LinearLayout>
