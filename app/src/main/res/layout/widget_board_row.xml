<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_board_row"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
    android:gravity="center_vertical">
    <TextView android:id="@+id/widget_board_row_name" android:layout_width="76dp" android:layout_height="wrap_content"
        android:textSize="12sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" />
    <LinearLayout android:id="@+id/widget_board_row_lines" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical" />
</LinearLayout>
