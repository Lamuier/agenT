<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_board_status_row"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
    android:gravity="center_vertical" android:paddingVertical="2dp">
    <ImageView android:id="@+id/widget_board_status_dot" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:importantForAccessibility="no" />
    <TextView android:id="@+id/widget_board_status_name" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginStart="8dp" android:textSize="13sp" android:includeFontPadding="false" android:maxLines="1" />
    <TextView android:id="@+id/widget_board_status_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="8dp" android:textSize="11sp" android:includeFontPadding="false" android:maxLines="1" />
    <TextView android:id="@+id/widget_board_status_word" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:minWidth="56dp" android:layout_marginStart="8dp" android:gravity="end" android:textSize="12sp"
        android:includeFontPadding="false" android:maxLines="1" />
</LinearLayout>
