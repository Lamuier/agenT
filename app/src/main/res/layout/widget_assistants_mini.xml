<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/widget_surface" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:importantForAccessibility="no" android:src="@drawable/widget_assistants_surface" />
    <ImageView android:id="@+id/widget_outline" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:alpha="0.65" android:importantForAccessibility="no" android:src="@drawable/widget_assistants_outline" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingHorizontal="12dp" android:paddingVertical="2dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:paddingEnd="5dp">
            <TextView android:id="@+id/widget_cursor_name" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Cursor" android:textSize="10sp" android:includeFontPadding="false" android:maxLines="1" />
            <TextView android:id="@+id/widget_cursor_value" android:layout_width="match_parent" android:layout_height="24dp"
                android:textSize="18sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="18sp"
                android:autoSizeStepGranularity="1sp" android:maxLines="1" />
            <ProgressBar android:id="@+id/widget_cursor_progress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="2dp" android:layout_marginTop="1dp" android:layout_marginBottom="2dp"
                android:max="100" android:progressDrawable="@drawable/widget_progress_primary" />
            <TextView android:id="@+id/widget_cursor_info" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/widget_current_cycle" android:textSize="9sp" android:includeFontPadding="false"
                android:paddingBottom="1dp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <ImageView android:id="@+id/widget_mini_divider" android:layout_width="1dp" android:layout_height="match_parent"
            android:layout_marginVertical="7dp" android:importantForAccessibility="no" android:background="@color/widget_surface_variant" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:paddingStart="5dp">
            <TextView android:id="@+id/widget_codex_name" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Codex · 5h" android:textSize="10sp" android:includeFontPadding="false" android:maxLines="1" />
            <TextView android:id="@+id/widget_codex_primary_value" android:layout_width="match_parent" android:layout_height="24dp"
                android:textSize="18sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="18sp"
                android:autoSizeStepGranularity="1sp" android:maxLines="1" />
            <ProgressBar android:id="@+id/widget_codex_primary_progress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="2dp" android:layout_marginTop="1dp" android:layout_marginBottom="2dp"
                android:max="100" android:progressDrawable="@drawable/widget_progress_primary" />
            <TextView android:id="@+id/widget_codex_week" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="9sp" android:paddingBottom="1dp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
